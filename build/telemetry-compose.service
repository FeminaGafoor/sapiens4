[Unit]
Description=Sapiens4 telemetry containers
Requires=docker.service
After=docker.service
PartOf=docker.service
RequiresMountsFor=/mnt/telemetry-data

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/bin/mountpoint -q /mnt/telemetry-data
ExecStart=/usr/bin/docker compose --env-file /etc/telemetry-simple/docker.env --project-name telemetry-simple -f /opt/telemetry-simple/docker/compose.yaml up -d --wait --wait-timeout 30
ExecStop=/usr/bin/docker compose --env-file /etc/telemetry-simple/docker.env --project-name telemetry-simple -f /opt/telemetry-simple/docker/compose.yaml stop --timeout 15
TimeoutStartSec=60
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
